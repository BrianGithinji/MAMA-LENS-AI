# ─── Secrets — NEVER commit these ───────────────────────────
backend/api/.env
apps/web/.env
.env.local
.env.*.local

# .env.production is safe to commit (no secrets, just the Render URL)
# .env.example is safe to commit (template only)

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
.venv*/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# ─── Database files ──────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ─── Node / Frontend ─────────────────────────────────────────
node_modules/
apps/web/dist/
apps/web/.vite/
*.log
npm-debug.log*

# ─── AI Models (large binary files — generated at runtime) ──
*.joblib
*.pkl
*.h5
*.pt
*.pth

# ─── Fine-tuned model weights (too large for git) ────────────
ai/mama_model/mama-flan-t5/

# ─── Training logs ───────────────────────────────────────────
backend/api/dl_out.txt

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ─────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
